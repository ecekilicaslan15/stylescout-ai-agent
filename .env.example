# HTTP port for uvicorn (cloud hosts inject PORT at runtime)
PORT=8000

# SQLite database file path (used when WARDROBE_BACKEND=sqlite)
DB_PATH=wardrobe/wardrobe.db

# Wardrobe storage backend: json (local dev) or sqlite (Docker / production)
WARDROBE_BACKEND=json

# OpenRouter API key for LLM calls (optional; rule-based planner runs when unset)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Legacy manual-test shortcut: Cookie stylescout_session=default (disabled unless true)
ALLOW_DEFAULT_OVERRIDE=false
