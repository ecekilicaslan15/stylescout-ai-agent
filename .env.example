# HTTP port for uvicorn (cloud hosts such as Render inject PORT at runtime; Docker CMD uses ${PORT:-8000})
PORT=8000

# Wardrobe storage backend: json (local dev) or sqlite (Docker / production)
WARDROBE_BACKEND=json

# SQLite database file path (used when WARDROBE_BACKEND=sqlite; parent dir is created on first connect)
DB_PATH=wardrobe/wardrobe.db

# JSON wardrobe file (used when WARDROBE_BACKEND=json; default is wardrobe/wardrobe.json in the repo)
WARDROBE_JSON_PATH=wardrobe/wardrobe.json

# Saved outfit history file (JSON backend only; SQLite stores outfits in DB_PATH)
SAVED_OUTFITS_JSON_PATH=wardrobe/saved_outfits.json

# Per-user shopping preferences file (max_price, size)
PREFERENCES_JSON_PATH=wardrobe/preferences.json

# OpenRouter API key for LLM calls (optional; rule-based planner runs when unset — USE_LLM is False in code today)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Legacy manual-test shortcut: Cookie stylescout_session=default (must stay false/unset on any public deployment)
ALLOW_DEFAULT_OVERRIDE=false
